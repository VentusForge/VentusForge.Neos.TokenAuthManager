# Include requried base fusion
include: resource://Avency.Plandent.BackendModule/Private/Fusion/Root.fusion
include: **/*.fusion

prototype(Neos.Fusion.Form:Neos.BackendModule.FieldContainer) {
    translation.label.package = 'VentusForge.Neos.TokenAuthManager'
    translation.label.source = 'Main'
}

VentusForge.Neos.TokenAuthManager.Module.TokenAuthManagerController.index = Neos.Fusion:Component {
    tokens = ${tokens}

    renderer = afx`
        <div class="neos-module-container">
            <div class="neos-row-fluid">
                <h1>{Translation.translate('VentusForge.Neos.TokenAuthManager:Modules:token-auth-manager.label')}</h1>
                <p>{Translation.translate('VentusForge.Neos.TokenAuthManager:Modules:token-auth-manager.description')}</p>
                <Neos.Fusion:Link.Action href.action="create" class="neos-button neos-button-primary">
                    <i class="fas fa-plus"></i>
                    {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.create')}
                </Neos.Fusion:Link.Action>
                <table class="neos-table">
                    <thead>
                    <tr>
                        <th>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:table.name')}</th>
                        <th>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:table.token')}</th>
                        <th>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:table.roles')}</th>
                        <th>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:table.settings')}</th>
                        <th>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:table.createdAt')}</th>
                        <th>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:table.expiresAt')}</th>
                    </tr>
                    </thead>
                    <tbody>
                    <Neos.Fusion:Loop items={props.tokens} itemName="token" @children="itemRenderer">
                        <tr>
                            <td>{token.label}</td>
                            <td>{token.hash}</td>
                            <td>
                                <Neos.Fusion:Loop items={token.roles} itemName="role" @children="itemRenderer">
                                    <span>{role}</span><br />
                                </Neos.Fusion:Loop>
                            </td>
                            <td @if.isNotEmpty={!Array.isEmpty(token.settings)}>
                                <Neos.Fusion:Loop items={token.settings} itemName="setting" @children="itemRenderer">
                                    <span>{itemKey}: {setting}</span><br />
                                </Neos.Fusion:Loop>
                            </td>
                            <td @if.isEmpty={Array.isEmpty(token.settings)}>-</td>
                            <td>{Date.format(token.createdAt, Translation.translate('VentusForge.Neos.TokenAuthManager:Main:dateTime.format'))}</td>
                            <td>
                                <span @if.hasExpiration={token.expiresAt}>{Date.format(token.expiresAt, Translation.translate('VentusForge.Neos.TokenAuthManager:Main:date.format'))}</span>
                                <br @if.isExpired={token.expiresAt && Date.format(token.expiresAt, 'U') < Date.format(Date.now(), 'U')} />
                                <span @if.isExpired={token.expiresAt && Date.format(token.expiresAt, 'U') < Date.format(Date.now(), 'U')} style="color: red; font-weight: bold;">
                                    {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:token.expired')}
                                </span>
                                <span @if.hasNoExpiration={!token.expiresAt} style="color: orange; font-weight: bold;">{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:token.noExpiration')}</span>
                            </td>

                            <td class="neos-action">
                                <div class="neos-pull-right">
                                    <Neos.Fusion:Link.Action href.action="edit" href.arguments.token={token} class="neos-button neos-button-primary">
                                        <i class="fas fa-pencil-alt"></i>
                                    </Neos.Fusion:Link.Action>

                                    <Neos.Fusion:Link.Action href.action="renew" href.arguments.token={token} class="neos-button neos-button-warning" title={Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.renew')}>
                                        <i class="fas fa-sync-alt"></i>
                                    </Neos.Fusion:Link.Action>

                                    <button class="neos-button neos-button-danger" data-toggle="modal" href={"#customer-delete-" + token.hash} data-neos-toggle="tooltip">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>

                                    <div class="neos-hide" id={"customer-delete-" + token.hash}>
                                        <div class="neos-modal-centered">
                                            <div class="neos-modal-content">
                                                <div class="neos-modal-header">
                                                    <button type="button" class="neos-close neos-button" data-bs-dismiss="modal"></button>
                                                    <div class="neos-header">
                                                        {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:delete.confirm.title')}
                                                    </div>
                                                    <div>
                                                        <div class="neos-subheader">
                                                            <p>
                                                                {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:delete.confirm.message')}<br />
                                                                {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:delete.confirm.irreversible')}
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="neos-modal-footer">
                                                    <a href="#" class="neos-button" data-bs-dismiss="modal">
                                                        {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.cancel')}
                                                    </a>
                                                    <Neos.Fusion.Form:Form
                                                        form.target.action="remove"
                                                        form.target.arguments.token={token}
                                                        attributes.class="neos-inline"
                                                    >
                                                        <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-danger">
                                                            {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.delete')}
                                                        </Neos.Fusion.Form:Button>
                                                    </Neos.Fusion.Form:Form>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="neos-modal-backdrop neos-in"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </Neos.Fusion:Loop>
                    </tbody>
                </table>

            </div>
        </div>
    `
}

VentusForge.Neos.TokenAuthManager.Module.TokenAuthManagerController.edit = Neos.Fusion:Component {
    token = ${token}
    isExpired = ${token.expiresAt && Date.format(token.expiresAt, 'U') < Date.format(Date.now(), 'U')}

    renderer = afx`
        <div class="neos-module-container">
            <div class="neos-row-fluid">
                <h1>{Translation.translate('VentusForge.Neos.TokenAuthManager:Modules:token-auth-manager.label')}</h1>
                <p>{Translation.translate('VentusForge.Neos.TokenAuthManager:Modules:token-auth-manager.description')}</p>
            </div>
        </div>
        <Neos.Fusion.Form:Form
            form.data.token={token}
            form.target.action="update"
        >
            <div class="neos-row-fluid neos-module-container">
                <fieldset class="neos-span6">
                    <legend>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:form.information')}</legend>
                    <div @if.isExpired={props.isExpired} style="background-color: #f2dede; border: 1px solid #eed3d7; color: #b94a48; padding: 8px 14px; margin-bottom: 18px; font-weight: bold;">
                        {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:token.expiredRenewalAlert')}
                    </div>
                    <Neos.Fusion.Form:Neos.BackendModule.FieldContainer field.name="token[label]" label="token.label">
                        <Neos.Fusion.Form:Input attributes.class="neos-span12" />
                    </Neos.Fusion.Form:Neos.BackendModule.FieldContainer>
                </fieldset>
            </div>

            <div class="neos-footer">
                <Neos.Fusion:Link.Action href.action="index" class="neos-button neos-button">
                    {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.cancel')}
                </Neos.Fusion:Link.Action>
                <Neos.Fusion:Link.Action href.action="renew" href.arguments.token={token} class="neos-button neos-button-warning">
                    {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.renew')}
                </Neos.Fusion:Link.Action>
                <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-primary">
                    {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.update')}
                </Neos.Fusion.Form:Button>
            </div>
        </Neos.Fusion.Form:Form>
    `
}

VentusForge.Neos.TokenAuthManager.Module.TokenAuthManagerController.create = Neos.Fusion:Component {
    renderer = afx`
        <div class="neos-module-container">
            <div class="neos-row-fluid">
                <h1>{Translation.translate('VentusForge.Neos.TokenAuthManager:Modules:token-auth-manager.label')}</h1>
                <p>{Translation.translate('VentusForge.Neos.TokenAuthManager:Modules:token-auth-manager.description')}</p>
            </div>
        </div>
        <Neos.Fusion.Form:Form
            form.target.action="add"
        >
            <div class="neos-row-fluid neos-module-container">
                <fieldset class="neos-span6">
                    <legend>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:form.information')}</legend>
                    <Neos.Fusion.Form:Neos.BackendModule.FieldContainer field.name="label" label="token.label">
                        <Neos.Fusion.Form:Input attributes.class="neos-span12" />
                    </Neos.Fusion.Form:Neos.BackendModule.FieldContainer>
                    <VentusForge.Neos.TokenAuthManager:ExpirationPresetField />
                </fieldset>

                <fieldset class="neos-span6">
                    <legend class="neos-control-label">{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:form.roles')}</legend>
                    <table class="neos-table" data-neos-expandable="dropdown-group">
                        <thead>
                        <tr>
                            <th></th>
                            <th>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:role.label')}</th>
                            <th>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:role.description')}</th>
                        </tr>
                        </thead>
                        <tbody>
                            <Neos.Fusion:Loop items={availableRoles} itemName="role" @children="itemRenderer">
                                <tr>
                                    <td>
                                        <div class="neos-controls">
                                            <label for={"roles-" + iterator.cycle} class="neos-checkbox" title={role.identifier} data-neos-toggle="tooltip" data-placement="right">
                                                <Neos.Fusion.Form:Checkbox field.name="roleIdentifiers" field.value={role.identifier} attributes.id={"roles-" + iterator.cycle} />
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="neos-controls">
                                        <label for={"roles-" + iterator.cycle} class="neos-checkbox" title={role.identifier} data-neos-toggle="tooltip" data-placement="right">
                                            {role.label}
                                        </label>
                                        </div>
                                    </td>
                                    <td>
                                        <label for={"roles-" + iterator.cycle} class="neos-checkbox" title={role.label} data-neos-toggle="tooltip" data-placement="right">{role.description}</label>
                                    </td>
                                </tr>
                            </Neos.Fusion:Loop>
                        </tbody>
                    </table>
                </fieldset>
            </div>

            <div class="neos-footer">
                <Neos.Fusion:Link.Action href.action="index" class="neos-button neos-button">
                    {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.cancel')}
                </Neos.Fusion:Link.Action>
                <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-success">
                    {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.create')}
                </Neos.Fusion.Form:Button>
            </div>
        </Neos.Fusion.Form:Form>
    `
}

VentusForge.Neos.TokenAuthManager.Module.TokenAuthManagerController.renew = Neos.Fusion:Component {
    token = ${token}
    isExpired = ${token.expiresAt && Date.format(token.expiresAt, 'U') < Date.format(Date.now(), 'U')}

    renderer = afx`
        <div class="neos-module-container">
            <div class="neos-row-fluid">
                <h1>{Translation.translate('VentusForge.Neos.TokenAuthManager:Modules:token-auth-manager.label')}</h1>
                <p>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:renew.description')}</p>
            </div>
        </div>
        <Neos.Fusion.Form:Form
            form.target.action="doRenew"
            form.target.arguments.token={token}
        >
            <div class="neos-row-fluid neos-module-container">
                <fieldset class="neos-span6">
                    <legend>{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:form.information')}</legend>
                    <div @if.isExpired={props.isExpired} style="background-color: #f2dede; border: 1px solid #eed3d7; color: #b94a48; padding: 8px 14px; margin-bottom: 18px; font-weight: bold;">
                        {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:token.expiredRenewalAlert')}
                    </div>
                    <div class="neos-control-group">
                        <label class="neos-control-label">{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:token.label')}</label>
                        <div class="neos-controls">
                            <input class="neos-span12" type="text" value={token.label} disabled="disabled" />
                        </div>
                    </div>
                    <div class="neos-control-group">
                        <label class="neos-control-label">{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:table.token')}</label>
                        <div class="neos-controls">
                            <input class="neos-span12" type="text" value={token.hash} disabled="disabled" />
                        </div>
                    </div>
                    <div class="neos-control-group">
                        <label class="neos-control-label">{Translation.translate('VentusForge.Neos.TokenAuthManager:Main:token.currentExpiresAt')}</label>
                        <div class="neos-controls">
                            <input @if.hasExpiration={token.expiresAt} class="neos-span12" type="text" value={Date.format(token.expiresAt, Translation.translate('VentusForge.Neos.TokenAuthManager:Main:date.format'))} disabled="disabled" />
                            <span @if.isExpired={props.isExpired} style="color: red; font-weight: bold; display: block; margin-top: 5px;">
                                {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:token.expired')}
                            </span>
                            <span @if.hasNoExpiration={!token.expiresAt} style="color: orange; font-weight: bold;">
                                {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:token.noExpiration')}
                            </span>
                        </div>
                    </div>
                    <VentusForge.Neos.TokenAuthManager:ExpirationPresetField />
                </fieldset>
            </div>

            <div class="neos-footer">
                <Neos.Fusion:Link.Action href.action="index" class="neos-button neos-button">
                    {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.cancel')}
                </Neos.Fusion:Link.Action>
                <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-warning">
                    {Translation.translate('VentusForge.Neos.TokenAuthManager:Main:action.renew')}
                </Neos.Fusion.Form:Button>
            </div>
        </Neos.Fusion.Form:Form>
    `
}
